# ── SUNDAY configuration ── copy the lines you need into .env (this file is committed — no real keys here)

# Brain (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# SUNDAY_MODEL=claude-opus-5-5
# SUNDAY_EFFORT=low            # low = fastest voice replies; medium/high = deeper reasoning
# SUNDAY_MEMORY_MODEL=         # model for background memory extraction (defaults to SUNDAY_MODEL)

# Voice (ElevenLabs) — https://elevenlabs.io → Developers → API keys (key starts with sk_, needs Text to Speech access)
# SUNDAY clones her voice from public/sunday_voice/sunday.mp3 automatically (needs a paid plan),
# or set ELEVENLABS_VOICE_ID to use a voice you already have.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_CONCURRENCY=3     # max simultaneous voice requests (your plan's limit minus one)

# Ears (speech-to-text) — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Wake word "Hey Sunday" runs offline with Vosk — no key needed (model lives in public/wake/).

# Gmail (read + drafts only) — Google Cloud Console → OAuth client "Web application"
# Authorised redirect URI: http://127.0.0.1:3210/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Images (Higgsfield) — https://cloud.higgsfield.ai → API Keys (shown once). Put it in .env.local as key-id:key-secret.
# API credit is pay-as-you-go and separate from the website plan. SUNDAY asks where to save every image.
HF_CREDENTIALS=
# SUNDAY_IMAGE_MODEL=higgsfield-ai/soul/v2/standard
# SUNDAY_IMAGE_MAX_USD=1       # refuse any single request estimated above this

# Blender — SUNDAY finds blender.exe in Program Files or a "Blender…" folder at a drive root
# SUNDAY_BLENDER=F:\Blender 5.1\blender.exe
# SUNDAY_BLENDER_PORT=9876     # local port for her bridge (blender/sunday_bridge.py)

# Computer
# SUNDAY_DRIVES=C,D,F
# SUNDAY_BROWSER=firefox       # firefox | chrome | edge | brave
# SUNDAY_PORT=3210
